<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="de.bsommerfeld.randomizer.ui.config.ConfigTabController">
    <top>
        <Label fx:id="statusLabel" maxWidth="Infinity" wrapText="true" styleClass="status">
            <padding>
                <Insets top="16" right="20" bottom="12" left="20"/>
            </padding>
        </Label>
    </top>
    <center>
        <TextArea fx:id="jsonArea" editable="false" styleClass="mono">
            <BorderPane.margin>
                <Insets right="20" left="20"/>
            </BorderPane.margin>
        </TextArea>
    </center>
    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <padding>
                <Insets top="12" right="20" bottom="20" left="20"/>
            </padding>
            <Button text="Reload" onAction="#onReload"/>
            <TextField fx:id="pathField" promptText="Path to the .vcfg for this tab" HBox.hgrow="ALWAYS"/>
            <Button text="Browse…" onAction="#onBrowse"/>
            <Button text="Load" onAction="#onLoad" defaultButton="true"/>
        </HBox>
    </bottom>
</BorderPane>
