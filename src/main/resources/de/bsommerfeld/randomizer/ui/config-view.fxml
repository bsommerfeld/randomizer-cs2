<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="de.bsommerfeld.randomizer.ui.config.ConfigTabController">
    <top>
        <Label fx:id="statusLabel" maxWidth="Infinity" wrapText="true">
            <padding>
                <Insets top="10" right="12" bottom="10" left="12"/>
            </padding>
        </Label>
    </top>
    <center>
        <TextArea fx:id="jsonArea" editable="false"
                  style="-fx-font-family: 'Consolas', 'Courier New', monospace;">
            <BorderPane.margin>
                <Insets right="12" left="12"/>
            </BorderPane.margin>
        </TextArea>
    </center>
    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="12" bottom="12" left="12"/>
            </padding>
            <Button text="Neu laden" onAction="#onReload"/>
            <TextField fx:id="pathField" promptText="Pfad zur .vcfg für diesen Tab" HBox.hgrow="ALWAYS"/>
            <Button text="Durchsuchen…" onAction="#onBrowse"/>
            <Button text="Laden" onAction="#onLoad" defaultButton="true"/>
        </HBox>
    </bottom>
</BorderPane>
