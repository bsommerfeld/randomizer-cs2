<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="de.bsommerfeld.randomizer.ui.overview.OverviewController">
    <top>
        <!-- StackPane, so the score sits on the window's center axis whatever the side texts say. -->
        <StackPane>
            <padding>
                <Insets top="16" right="20" bottom="12" left="20"/>
            </padding>
            <VBox StackPane.alignment="CENTER_LEFT" alignment="CENTER_LEFT" spacing="2"
                  maxWidth="-Infinity" maxHeight="-Infinity">
                <Label fx:id="mapLabel" styleClass="map-label"/>
                <Label fx:id="modeLabel" styleClass="mode-label"/>
            </VBox>
            <VBox alignment="CENTER" maxWidth="-Infinity" maxHeight="-Infinity">
                <Label fx:id="timeLabel" styleClass="time-label" managed="false" visible="false"/>
                <HBox alignment="CENTER" spacing="10">
                    <Label fx:id="ctScoreLabel" text="0" styleClass="score-big,team-ct"/>
                    <Label text=":" styleClass="score-colon"/>
                    <Label fx:id="tScoreLabel" text="0" styleClass="score-big,team-t"/>
                </HBox>
            </VBox>
            <Label fx:id="bombLabel" StackPane.alignment="CENTER_RIGHT" styleClass="bomb-label"
                   managed="false" visible="false"/>
        </StackPane>
    </top>
    <center>
        <StackPane>
            <!-- Scoreboard (spectator/observer): two team tables + detail panel -->
            <HBox fx:id="scoreboardBox" spacing="16" managed="false" visible="false">
                <padding>
                    <Insets top="4" right="20" bottom="20" left="10"/>
                </padding>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Counter-Terrorists" styleClass="team-title,team-ct"/>
                    <TableView fx:id="ctTable" VBox.vgrow="ALWAYS"/>
                    <Label text="Terrorists" styleClass="team-title,team-t"/>
                    <TableView fx:id="tTable" VBox.vgrow="ALWAYS"/>
                </VBox>
                <ScrollPane fitToWidth="true" styleClass="detail-panel" prefWidth="300" minWidth="260">
                    <VBox fx:id="detailContent" spacing="4" styleClass="detail-body"/>
                </ScrollPane>
            </HBox>
            <!-- Fallback (normal match): hint + own player card -->
            <VBox fx:id="placeholderBox" spacing="14">
                <padding>
                    <Insets top="4" right="20" bottom="20" left="20"/>
                </padding>
                <Label fx:id="placeholderLabel" wrapText="true" text="Waiting for data from CS2 …"
                       styleClass="placeholder-label"/>
                <!-- Hidden until CS2 sent a player, an empty card only looks broken. -->
                <ScrollPane fx:id="ownPlayerCard" fitToWidth="true" styleClass="detail-panel" VBox.vgrow="ALWAYS"
                            managed="false" visible="false">
                    <VBox fx:id="ownPlayerContent" spacing="4" styleClass="detail-body"/>
                </ScrollPane>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
