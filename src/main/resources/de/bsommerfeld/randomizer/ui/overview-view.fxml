<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="de.bsommerfeld.randomizer.ui.OverviewController"
            stylesheets="@overview.css">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="header-bar">
            <padding>
                <Insets top="10" right="14" bottom="10" left="14"/>
            </padding>
            <Label fx:id="mapLabel" text="-" styleClass="map-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER" spacing="2">
                <Label fx:id="timeLabel" styleClass="time-label" managed="false" visible="false"/>
                <HBox alignment="CENTER" spacing="8" styleClass="score-box">
                    <Label fx:id="ctScoreLabel" text="0" styleClass="score-big,team-ct"/>
                    <Label text=":" styleClass="score-colon"/>
                    <Label fx:id="tScoreLabel" text="0" styleClass="score-big,team-t"/>
                </HBox>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="bombLabel" styleClass="bomb-label" managed="false" visible="false"/>
        </HBox>
    </top>
    <center>
        <StackPane>
            <!-- Scoreboard (spectator/observer): two team tables + detail panel -->
            <HBox fx:id="scoreboardBox" spacing="10" managed="false" visible="false">
                <padding>
                    <Insets top="8" right="14" bottom="12" left="14"/>
                </padding>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Counter-Terrorists" styleClass="team-title,team-ct"/>
                    <TableView fx:id="ctTable" VBox.vgrow="ALWAYS"/>
                    <Label text="Terrorists" styleClass="team-title,team-t"/>
                    <TableView fx:id="tTable" VBox.vgrow="ALWAYS"/>
                </VBox>
                <ScrollPane fitToWidth="true" styleClass="detail-panel" prefWidth="300" minWidth="260">
                    <VBox fx:id="detailContent" spacing="4" styleClass="detail-body"/>
                </ScrollPane>
            </HBox>
            <!-- Fallback (normal match): hint + own player card -->
            <VBox fx:id="placeholderBox" spacing="12" styleClass="placeholder">
                <padding>
                    <Insets top="16" right="18" bottom="16" left="18"/>
                </padding>
                <Label fx:id="placeholderLabel" wrapText="true" text="Warte auf Daten von CS2 …"
                       styleClass="placeholder-label"/>
                <ScrollPane fitToWidth="true" styleClass="detail-panel,player-card" VBox.vgrow="ALWAYS">
                    <VBox fx:id="ownPlayerContent" spacing="4" styleClass="detail-body"/>
                </ScrollPane>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
